#!/bin/sh

SCRIPT=/opt/sbin/awg-port-hopper
PIDFILE=/opt/var/run/awg-port-hopper.pid
LOGFILE=/opt/var/log/awg-port-hopper.log

is_running() {
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && grep -q "$SCRIPT" "/proc/$pid/cmdline" 2>/dev/null
}

start() {
    if is_running; then
        echo "AWG port hopper already running (PID $pid)"
        return 0
    fi
    rm -f "$PIDFILE"
    mkdir -p /opt/var/run /opt/var/log
    /opt/sbin/start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -O "$LOGFILE" -- "$SCRIPT"
    sleep 1
    if is_running; then
        echo "AWG port hopper started (PID $pid)"
        return 0
    fi
    echo "AWG port hopper failed to start"
    return 1
}

stop() {
    if is_running; then
        /opt/sbin/start-stop-daemon -K -p "$PIDFILE" -s TERM
    fi
    rm -f "$PIDFILE"
    echo "AWG port hopper stopped"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status)
        if is_running; then
            echo "AWG port hopper running (PID $pid)"
        else
            echo "AWG port hopper stopped"
            exit 1
        fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
