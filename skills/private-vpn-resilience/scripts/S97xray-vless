#!/bin/sh

BIN=/opt/bin/xray-vless
CONFIG=/opt/etc/xray-vless/config.json
PIDFILE=/var/run/xray-vless.pid
LOGFILE=/opt/var/log/xray-vless.log

is_running() {
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    [ -n "$pid" ] && [ -d "/proc/$pid" ] && grep -q "$BIN" "/proc/$pid/cmdline" 2>/dev/null
}

start() {
    if is_running; then
        echo "Xray VLESS client already running (PID $pid)"
        return 0
    fi
    rm -f "$PIDFILE"
    mkdir -p /opt/var/log /var/run
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$BIN" -O "$LOGFILE" -- run -config "$CONFIG"
    sleep 2
    if is_running; then
        echo "Xray VLESS client started (PID $pid)"
        return 0
    fi
    echo "Xray VLESS client failed to start"
    return 1
}

stop() {
    if is_running; then
        start-stop-daemon -K -p "$PIDFILE" -x "$BIN" -s TERM
    fi
    rm -f "$PIDFILE"
    echo "Xray VLESS client stopped"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status)
        if is_running; then
            echo "Xray VLESS client running (PID $pid)"
        else
            echo "Xray VLESS client stopped"
            exit 1
        fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
